{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/DiscordLite_API/bin/Debug/net10.0/DiscordLite_API.dll",
      "args": [],
      "cwd": "${workspaceFolder}/DiscordLite_API",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openUrl",
        "pattern": "\\bnow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      }
    },
    {
      "name": "WEB",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/DiscordLite_WEB/bin/Debug/net10.0/DiscordLite_WEB.dll",
      "args": [],
      "cwd": "${workspaceFolder}/DiscordLite_WEB",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openUrl",
        "pattern": "\\bnow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s"
      }
    }
  ],
  "compounds": [
    {
      "name": "API + WEB (ორივე ერთად)",
      "configurations": ["API", "WEB"]
    }
  ]
}